  "services": {
    "bind_entity": {
      "name": "绑定实体到耗材",
      "description": "将设备耗材实体绑定到耗材库中的耗材（按设备自动匹配或手动指定 consumable_id），写入对应类型条目的绑定列表；可选关联一个库存项。",
      "fields": {
        "entity_id": {
          "name": "实体",
          "description": "要绑定的设备耗材实体（如 sensor.filter_life）"
        },
        "consumable_id": {
          "name": "耗材 ID",
          "description": "要绑定的耗材，留空按设备自动匹配"
        },
        "item": {
          "name": "关联库存项",
          "description": "可选关联的库存项"
        },
        "record_device": {
          "name": "记入设备映射",
          "description": "同时将「厂商+型号→耗材」合并追加进用户库设备映射（不覆盖既有）"
        }
      }
    },
    "unbind_entity": {
      "name": "解除绑定",
      "description": "移除实体到耗材的绑定（用于纠正误绑）。",
      "fields": {
        "entity_id": {
          "name": "实体",
          "description": "要解除绑定的实体（如 sensor.filter_life）"
        }
      }
    },
    "query_binding": {
      "name": "查询绑定",
      "description": "查询实体与耗材的绑定关系（按实体、耗材或库存项过滤）。传入 entity_id 时，额外返回该实体的设备信息（entity_info）与库内推荐耗材（suggested），便于绑定前查询。",
      "fields": {
        "entity_id": {
          "name": "实体",
          "description": "按实体过滤"
        },
        "consumable_id": {
          "name": "耗材 ID",
          "description": "按耗材过滤"
        },
        "item": {
          "name": "库存项",
          "description": "按库存项过滤"
        }
      }
    },
    "add_consumable": {
      "name": "添加耗材到用户库",
      "description": "按模板字段添加耗材，写入本地用户库（config/.consumable_manager/user_library.json，原子写盘）。耗材 ID 自动生成（类型+型号），如 filter_hepa13；冲突时链接内置条目或追加短哈希。",
      "fields": {
        "cons_type": {
          "name": "耗材类型",
          "description": "耗材类型（内置或自定义键）"
        },
        "model": {
          "name": "型号",
          "description": "型号（用于生成耗材 ID）"
        },
        "name": {
          "name": "名称",
          "description": "显示名称"
        },
        "unit": {
          "name": "单位",
          "description": "计量单位（如 个、片、毫升）"
        },
        "meta": {
          "name": "规格信息",
          "description": "可选规格（JSON 对象）"
        }
      }
    },
    "add_device": {
      "name": "添加设备映射",
      "description": "在本地用户库中新增或覆盖设备与耗材的映射关系（锚点：制造商 + 型号，重叠整条替换，原子写盘）。",
      "fields": {
        "manufacturer": {
          "name": "制造商",
          "description": "设备制造商"
        },
        "models": {
          "name": "型号列表",
          "description": "设备型号（JSON 字符串数组）"
        },
        "name": {
          "name": "设备名称",
          "description": "设备显示名称"
        },
        "consumables": {
          "name": "耗材 ID 列表",
          "description": "设备使用的耗材 ID（JSON 字符串数组）"
        }
      }
    },
    "add_type": {
      "name": "添加自定义类型",
      "description": "在本地用户库中新增自定义耗材类型（config/.consumable_manager/user_library.json，原子写盘）。类型键仅允许小写字母、数字与下划线且不可与已有类型重复（新建语义）；阈值字段与内置类型同构。",
      "fields": {
        "type_key": {
          "name": "类型键",
          "description": "类型键（小写字母、数字、下划线，必须唯一）"
        },
        "name": {
          "name": "名称",
          "description": "类型显示名称"
        },
        "icon": {
          "name": "图标",
          "description": "MDI 图标（默认 mdi:package-variant）"
        },
        "default_threshold_type": {
          "name": "默认阈值类型",
          "description": "新类型的默认阈值类型"
        },
        "default_threshold": {
          "name": "默认阈值",
          "description": "默认阈值数值"
        },
        "default_threshold_unit": {
          "name": "默认阈值单位",
          "description": "默认阈值单位"
        }
      }
    },
    "extract": {
      "name": "提取数据",
      "description": "提取条目的结构化数据（可指定数据项）。",
      "fields": {
        "include": {
          "name": "数据项",
          "description": "要包含的数据项（库存 / 耗材类型条目）"
        }
      }
    },
    "adjust_stock": {
      "name": "调整库存",
      "description": "增加或减少库存项数量（按库存项选择框选择）。",
      "fields": {
        "action": {
          "name": "操作",
          "description": "add 为增加，consume 为减少"
        },
        "quantity": {
          "name": "数量",
          "description": "增加或消耗的数量"
        },
        "item": {
          "name": "库存项",
          "description": "要调整的库存项"
        }
      }
    }
  }
