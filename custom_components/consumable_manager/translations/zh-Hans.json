  "services": {
    "bind_entity": {
      "name": "绑定实体到耗材",
      "description": "将设备耗材实体绑定到耗材库中的耗材（显式指定 consumable_id 或关联库存项继承），写入对应类型条目的绑定列表；可选关联一个库存项。",
      "fields": {
        "entity_id": {
          "name": "实体",
          "description": "要绑定的设备耗材实体（如 sensor.filter_life）"
        },
        "consumable_id": {
          "name": "耗材 ID",
          "description": "要绑定的耗材（必填：显式指定或经关联库存项继承）"
        },
        "item": {
          "name": "关联库存项",
          "description": "可选关联的库存项"
        },
        "group_id": {
          "name": "目标分组",
          "description": "绑定写入的目标分组 ID；留空写入默认分组（无分组则自动创建默认分组）"
        }
      }
    },
    "unbind_entity": {
      "name": "解除绑定",
      "description": "移除实体到耗材的绑定（用于纠正误绑）。",
      "fields": {
        "entity_id": {
          "name": "实体",
          "description": "要解除绑定的实体（如 sensor.filter_life）"
        }
      }
    },
    "query_binding": {
      "name": "查询绑定",
      "description": "查询实体与耗材的绑定关系（按实体、耗材或库存项过滤）。仅返回实体与耗材的映射，不查询设备注册表的厂商 / 型号 / 区域等设备信息。",
      "fields": {
        "entity_id": {
          "name": "实体",
          "description": "按实体过滤"
        },
        "consumable_id": {
          "name": "耗材 ID",
          "description": "按耗材过滤"
        },
        "item": {
          "name": "库存项",
          "description": "按库存项过滤"
        }
      }
    },
    "add_consumable": {
      "name": "添加耗材到用户库",
      "description": "按模板字段添加耗材，写入本地用户库（config/.consumable_manager/user_library.json，原子写盘）。耗材 ID 自动生成（类型+型号），如 filter_hepa13；冲突时链接内置条目或追加短哈希。",
      "fields": {
        "cons_type": {
          "name": "耗材类型",
          "description": "耗材类型（内置或自定义键）"
        },
        "model": {
          "name": "型号",
          "description": "型号（用于生成耗材 ID）"
        },
        "name": {
          "name": "名称",
          "description": "显示名称"
        },
        "unit": {
          "name": "单位",
          "description": "计量单位（如 个、片、毫升）"
        },
        "meta": {
          "name": "规格信息",
          "description": "可选规格（JSON 对象）"
        }
      }
    },
    "add_type": {
      "name": "添加自定义类型",
      "description": "在本地用户库中新增自定义耗材类型（config/.consumable_manager/user_library.json，原子写盘）。类型键仅允许小写字母、数字与下划线且不可与已有类型重复（新建语义）；阈值字段与内置类型同构。",
      "fields": {
        "type_key": {
          "name": "类型键",
          "description": "类型键（小写字母、数字、下划线，必须唯一）"
        },
        "name": {
          "name": "名称",
          "description": "类型显示名称"
        },
        "icon": {
          "name": "图标",
          "description": "MDI 图标（默认 mdi:package-variant）"
        },
        "default_threshold_type": {
          "name": "默认阈值类型",
          "description": "新类型的默认阈值类型"
        },
        "default_threshold": {
          "name": "默认阈值",
          "description": "默认阈值数值"
        },
        "default_threshold_unit": {
          "name": "默认阈值单位",
          "description": "默认阈值单位"
        }
      }
    },
    "query_data": {
      "name": "查询数据",
      "description": "查询本集成的各类数据；必须指定数据种类（data_type）。group_data 可按下方条件细分，其余种类直接返回全量。",
      "fields": {
        "data_type": {
          "name": "数据种类",
          "description": "stock 库存条目 / type_entry 耗材类型条目 / group_data 分组实体数据 / types 类型元数据 / consumables 耗材"
        },
        "consumable_type": {
          "name": "耗材类型",
          "description": "仅 group_data / consumables 生效：按耗材类型过滤（如 filter 滤芯）"
        },
        "entry_id": {
          "name": "条目",
          "description": "仅 group_data 生效：选择要查询的集成条目（下拉已添加条目）"
        },
        "group_entity": {
          "name": "分组",
          "description": "仅 group_data 生效：选择要查询的分组（选择该分组对应的实体）"
        },
        "triggered_only": {
          "name": "仅已触发",
          "description": "仅 group_data 生效：仅返回存在已触发成员的分组"
        }
      }
    },
    "adjust_stock": {
      "name": "调整库存",
      "description": "增加或减少库存项数量（按库存项选择框选择）。",
      "fields": {
        "action": {
          "name": "操作",
          "description": "add 为增加，consume 为减少"
        },
        "quantity": {
          "name": "数量",
          "description": "增加或消耗的数量"
        },
        "item": {
          "name": "库存项",
          "description": "要调整的库存项"
        }
      }
    }
  }
